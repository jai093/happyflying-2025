# ⚠️ IMPORTANT: This is a TEMPLATE file only
# DO NOT expose real values in this file
# Copy to .env.local and fill in your actual values

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/happyflying?retryWrites=true&w=majority

# JWT Secrets (Use strong, random 32+ character strings)
# Generate: openssl rand -base64 32
JWT_SECRET=your_32_character_minimum_secret_key_here_generate_random
JWT_REFRESH_SECRET=your_32_character_minimum_refresh_secret_here_generate_random

# Admin Credentials (Legacy - will be migrated to MongoDB)
# SECURITY NOTE: These should come from environment variables only, not hardcoded
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# CORS Configuration
# List of domains allowed to access the API (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://happyflying.com,https://www.happyflying.com

# Content Security Policy - Whitelisted Hosts
CSP_SCRIPT_HOSTS=https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com
CSP_STYLE_HOSTS=https://cdn.jsdelivr.net,https://cdnjs.cloudflare.com
CSP_FONT_HOSTS=https://fonts.googleapis.com,https://fonts.gstatic.com

# Optional: Error Tracking
# SENTRY_DSN=https://your_key@sentry.io/your_project_id

# Optional: Redis Cache/Sessions (for production)
# REDIS_URL=redis://username:password@host:port

# Optional: Email/SMTP Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_app_password

# Optional: SMS Provider (Twilio)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# Node Environment
NODE_ENV=development

# ============================================================
# SETUP INSTRUCTIONS FOR DEVELOPERS
# ============================================================
#
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Fill in actual values (keep in .env.local, never commit)
#    - Never share .env.local
#    - Never commit .env.local
#
# 3. For Vercel deployment:
#    - Add environment variables in Vercel Dashboard
#    - Project Settings → Environment Variables
#    - Do NOT commit secrets to GitHub
#
# 4. Never expose secrets in:
#    - Code comments
#    - Console logs
#    - Git repositories
#    - Public documentation
#
# ============================================================
